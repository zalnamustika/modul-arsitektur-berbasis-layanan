          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(http_server_requests_seconds_sum{application=~\"(?i)email-service\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=~\"(?i)email-service\"}[5m]))",
          "legendFormat": "avg (semua endpoint)",
          "refId": "B"
        }
      ],
      "title": "Email Service \u2014 Response Time (p95 & avg)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
